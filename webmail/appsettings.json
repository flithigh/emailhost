{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "MasterPostgreSql": "Host=localhost;Port=5432;Database=flitflap_master;Username=postgres;Password=postgres;",
    "TenantPostgreSql": "Host=localhost;Port=5432;Database=flitflap_tenant_default;Username=postgres;Password=postgres;",
    "MasterSqlite": "Data Source=flitflap_master.db",
    "TenantSqlite": "Data Source=flitflap_tenant.db"
  },
  "Garage": {
    "Enabled": true,
    "Endpoint": "http://localhost:3900",
    "Bucket": "flitflap-mail-store",
    "Region": "garage",
    "AccessKey": "garage_access_key",
    "SecretKey": "garage_secret_key",
    "LocalFallbackDir": "storage/garage_fallback"
  },
  "Jwt": {
    "SecretKey": "flitflap_super_secret_jwt_key_that_is_at_least_32_bytes_long!",
    "Issuer": "flitflap-webmail",
    "Audience": "flitflap-users",
    "ExpiryHours": 24
  },
  "SmtpRelay": {
    "Host": "localhost",
    "Port": 587,
    "UseSsl": false,
    "AllowUnauthenticatedLocal": true
  }
}

